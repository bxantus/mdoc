{
	"name": "mdoc",
	"displayName": "mdoc - Markdown Documentation Viewer",
	"description": "markdown documentation viewer for Visual Studio Code",
	"version": "1.6.0-prerelease",
	"publisher": "bxantus",
	"repository": {
		"type": "git",
		"url": "https://github.com/bxantus/mdoc.git"
	},
	"author": {
		"name": "Botond Xantus"
	},
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.73.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mdoc",
					"title": "%mdoc.activitybar.title%",
					"icon": "media/library_books.svg"
				}
			]
		},
		"views": {
			"mdoc": [
				{
					"id": "mdocProjects",
					"name": "%mdoc.view.mdoc.name%",
					"icon": ""
				}
			]
		},
		"commands": [
			{
				"command": "mdoc.add.fromFilesystem",
				"title": "%mdoc.add.fromFilesystem.title%",
				"category": "mdoc"
			},
			{
				"command": "mdoc.add.fromGit",
				"title": "%mdoc.add.fromGit.title%",
				"enablement": "false",
				"category": "mdoc"
			},
			{
				"command": "mdoc.project.update",
				"title": "%mdoc.project.update.title%",
				"icon": "$(sync)"
			},
			{
				"command": "mdoc.project.search",
				"title": "%mdoc.project.search.title%",
				"icon": "$(search)"
			},
			{
				"command": "mdoc.project.closeSearch",
				"title": "%mdoc.project.closeSearch.title%",
				"icon": "$(close)"
			},
			{
				"command": "mdoc.project.remove",
				"title": "%mdoc.project.remove.title%"
			},
			{
				"command": "mdoc.open",
				"title": "%mdoc.open.title%",
				"category": "mdoc"
			},
			{
				"command": "mdoc.openSourceFromSidebar",
				"title": "%mdoc.openSourceFromSidebar.title%"
			},
			{
				"command": "mdoc.openIndexFromSidebar",
				"title": "%mdoc.openIndexFromSidebar.title%"
			}
		],
		"menus": {
			"view/item/context": [
				{
					"command": "mdoc.project.update",
					"when": "view == mdocProjects && viewItem == project",
					"group": "inline"
				},
				{
					"command": "mdoc.project.search",
					"when": "view == mdocProjects && viewItem == project",
					"group": "inline"
				},
				{
					"command": "mdoc.project.closeSearch",
					"when": "view == mdocProjects && viewItem == search",
					"group": "inline"
				},
				{
					"command": "mdoc.project.remove",
					"when": "view == mdocProjects && viewItem == project",
					"group": "2_project_commands"
				},
				{
					"command": "mdoc.openSourceFromSidebar",
					"when": "view == mdocProjects && viewItem =~ /^docNode$|^project$/",
					"group": "1_node_commands"
				},
				{
					"command": "mdoc.openIndexFromSidebar",
					"when": "view == mdocProjects && viewItem == project",
					"group": "1_node_commands"
				}
			],
			"view/title": [
				{
					"command": "mdoc.add.fromGit",
					"when": "view == mdocProjects"
				},
				{
					"command": "mdoc.add.fromFilesystem",
					"when": "view == mdocProjects"
				}
			],
			"commandPalette": [
				{
					"command": "mdoc.project.update",
					"when": "false"
				},
				{
					"command": "mdoc.project.search",
					"when": "false"
				},
				{
					"command": "mdoc.project.closeSearch",
					"when": "false"
				},
				{
					"command": "mdoc.project.remove",
					"when": "false"
				},
				{
					"command": "mdoc.openSourceFromSidebar",
					"when": "false"
				},
				{
					"command": "mdoc.openIndexFromSidebar",
					"when": "false"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "mdocProjects",
				"contents": "%mdoc.view.mdocProjects.content%"
			}
		],
		"keybindings": [
			{
				"key": "Ctrl+F1",
				"command": "mdoc.open"
			}
		]
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"clean": "rimraf out",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"compile-tests": "tsc -p . --outDir out",
		"l10n": "npx @vscode/l10n-dev export --outDir ./l10n ./src",
		"lint": "eslint src",
		"package": "npm run clean && npm run check-types && npm run lint && node esbuild.js --production",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"test": "vscode-test",
		"vscode:prepublish": "npm run package",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch-tests": "tsc -p . -w --outDir out",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/lunr": "^2.3.3",
		"@types/mark.js": "^8.11.12",
		"@types/mocha": "^7.0.2",
		"@types/node": "^24.0.0",
		"@types/node-fetch": "^2.6.13",
		"@types/vscode": "^1.73.0",
		"@types/vscode-webview": "^1.57.5",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"glob": "^13.0.6",
		"mocha": "^12.0.3",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1"
	},
	"dependencies": {
		"@vscode/codicons": "^0.0.46-24",
		"@vscode/l10n": "^0.0.18",
		"highlight.js": "^11.12.0",
		"lunr": "^2.3.9",
		"mark.js": "^8.11.1",
		"markdown-it": "^14.3.3",
		"markdown-it-anchor": "^10.0.0",
		"node-fetch": "^3.3.2"
	}
}
